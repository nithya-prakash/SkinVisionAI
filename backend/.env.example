# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- App ---
ENVIRONMENT=development
DEBUG=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://skinvision:skinvision@localhost:5435/skinvision
POSTGRES_USER=skinvision
POSTGRES_PASSWORD=skinvision
POSTGRES_DB=skinvision

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3010

# --- LLM provider (Phase 6) ---
# One of: anthropic | openai | fake
# "fake" needs no key/network -- deterministic, offline explanations for
# local dev or CI/Docker verification. See docs/llm.md.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# Only used by the "openai" provider, to target a self-hosted/proxy/
# alternate OpenAI-compatible endpoint. Leave unset to use the real
# OpenAI API.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30.0

# --- Agent tool-calling layer (Phase 7) ---
# Hard limits on the agent loop so it can never spin indefinitely. See
# docs/agent.md. Defaults shown.
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_RESULT_CHARS=20000

# --- Uploads / image handling (Phase 2) ---
UPLOAD_DIRECTORY=./data/uploads
IMAGE_MAX_SIZE_MB=8
# temporary | none (portfolio/demo mode retains images briefly for processing only)
IMAGE_RETENTION_MODE=temporary

# --- Image quality gate thresholds (Phase 2) ---
# See docs/vision.md for methodology. Defaults shown.
IMAGE_MIN_WIDTH_PX=400
IMAGE_MIN_HEIGHT_PX=400
IMAGE_BLUR_VARIANCE_THRESHOLD=80.0
IMAGE_BRIGHTNESS_MIN=40.0
IMAGE_BRIGHTNESS_MAX=215.0
IMAGE_CONTRAST_MIN_STD=15.0

# --- Vision preprocessing / region-of-interest (Phase 3) ---
# See docs/vision.md for methodology. Defaults shown.
VISION_MAX_ANALYSIS_DIMENSION=1024
VISION_FACE_MIN_SIZE_FRACTION=0.15
VISION_FACE_MARGIN_FRACTION=0.25
VISION_CENTER_CROP_FRACTION=0.6

# --- Vision feature thresholds (Phase 3) ---
# See docs/vision.md for methodology and the real-test-driven rationale
# behind each. Defaults shown.
VISION_REDNESS_NORM_MAX=12.0
VISION_REDNESS_MILD_MIN=0.2
VISION_REDNESS_MODERATE_MIN=0.45
VISION_REDNESS_PRONOUNCED_MIN=0.7

VISION_TEXTURE_NORM_MAX=600.0
VISION_TEXTURE_MILD_MIN=0.2
VISION_TEXTURE_MODERATE_MIN=0.45
VISION_TEXTURE_PRONOUNCED_MIN=0.7

VISION_SHINE_BRIGHTNESS_MIN=220.0
VISION_SHINE_SATURATION_MAX=60.0
VISION_SHINE_MILD_MIN=0.02
VISION_SHINE_MODERATE_MIN=0.06
VISION_SHINE_PRONOUNCED_MIN=0.12

VISION_TONE_NORM_MAX=18.0
VISION_TONE_MILD_MIN=0.2
VISION_TONE_MODERATE_MIN=0.45
VISION_TONE_PRONOUNCED_MIN=0.7

VISION_SPOTS_DIFF_THRESHOLD=18
VISION_SPOTS_MIN_AREA_PX=12
VISION_SPOTS_MAX_AREA_FRACTION=0.02
VISION_SPOTS_NORM_MAX_COUNT=25
VISION_SPOTS_MILD_MIN=0.15
VISION_SPOTS_MODERATE_MIN=0.4
VISION_SPOTS_PRONOUNCED_MIN=0.7

# --- Rate limiting (Phase 12 follow-up) ---
# Per-client-IP fixed-window limits on the two endpoints with a real
# per-request cost (LLM tokens, CV pipeline CPU) in an app with no
# authentication. See app/core/rate_limit.py for the exact semantics
# and its documented limitations (single-process only, not
# X-Forwarded-For-aware).
RATE_LIMIT_UPLOAD_MAX_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60.0
RATE_LIMIT_AGENT_CHAT_MAX_REQUESTS=20
RATE_LIMIT_AGENT_CHAT_WINDOW_SECONDS=60.0

# --- Logging ---
LOG_LEVEL=INFO
